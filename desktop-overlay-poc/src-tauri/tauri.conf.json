{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPCV Overlay PoC",
  "version": "0.1.2",
  "identifier": "jp.syouziroupc.cpcv.overlay.poc",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CPCV Overlay PoC",
        "width": 620,
        "height": 840,
        "minWidth": 460,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
